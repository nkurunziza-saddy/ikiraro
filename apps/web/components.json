{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/index.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "hugeicons",
  "rtl": true,
  "menuColor": "default",
  "menuAccent": "subtle",
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "registries": {
    "@coss": "https://coss.com/ui/r/{name}.json",
    "@unlumen-ui": "https://ui.unlumen.com/r/{name}.json",
    "@moleculeui": "https://www.moleculeui.design/r/{name}.json",
    "@aceternity": "https://ui.aceternity.com/registry/{name}.json",
    "@fab-ui": "https://fab-ui.com/r/{name}.json",
    "@componentry": "https://componentry.fun/r/{name}.json",
    "@gammaui": "https://www.gammaui.com/r/{name}.json",
    "@magicui": "https://magicui.design/r/{name}"
  }
}
