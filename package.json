{
  "name": "ikiraro",
  "private": true,
  "homepage": "https://github.com/nkurunziza-saddy/ikiraro#readme",
  "bugs": {
    "url": "https://github.com/nkurunziza-saddy/ikiraro/issues"
  },
  "author": "Saddy Nkurunziza <nkurunziza-saddy>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkurunziza-saddy/ikiraro.git"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^6.0.3",
      "@types/node": "^25.6.2",
      "vitest": "4.1.11",
      "@vitest/ui": "^4.1.5",
      "@vitest/coverage-v8": "^4.1.5",
      "jsdom": "^29.1.1",
      "effect": "^3.12.0",
      "@effect/platform": "^0.69.0",
      "@effect/platform-browser": "^0.69.0",
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
      "vite-plus": "0.3.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "test": "turbo run test",
    "lint": "vp check",
    "format": "vp fmt",
    "changeset": "changeset",
    "version": "changeset version && pnpm install",
    "release": "pnpm run build && pnpm run check-types && pnpm run test && changeset publish",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@ikiraro/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.3.4"
}
