{
  "name": "ikiraro",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/node": "^25.6.2",
      "valibot": "^1.4.0",
      "i18next": "^26.1.0",
      "vitest": "^4.1.5",
      "@vitest/ui": "^4.1.5",
      "@vitest/coverage-v8": "^4.1.5",
      "jsdom": "^29.1.1",
      "effect": "^3.12.0",
      "@effect/platform": "^0.69.0",
      "@effect/platform-browser": "^0.69.0",
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "test": "turbo run test",
    "check": "oxlint && oxfmt --write",
    "release:sdk:version:patch": "bun scripts/bump-sdk-version.mjs patch && bun install",
    "release:sdk:version:minor": "bun scripts/bump-sdk-version.mjs minor && bun install",
    "release:sdk:version:major": "bun scripts/bump-sdk-version.mjs major && bun install",
    "release:sdk:verify": "bun run build && bun run check-types && bun run test && cd packages/sdk && bun pm pack --dry-run",
    "release:sdk:publish": "bun run release:sdk:verify && cd packages/sdk && npm publish --access public",
    "prepare": "husky"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ikiraro/config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "turbo": "^2.9.12",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*": [
      "oxlint",
      "oxfmt --write"
    ]
  },
  "packageManager": "bun@1.3.11"
}
