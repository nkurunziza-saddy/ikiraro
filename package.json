{
  "name": "ikiraro",
  "private": true,
  "homepage": "https://github.com/nkurunziza-saddy/ikiraro#readme",
  "bugs": {
    "url": "https://github.com/nkurunziza-saddy/ikiraro/issues"
  },
  "author": "Saddy Nkurunziza <nkurunziza-saddy>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkurunziza-saddy/ikiraro.git"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^6.0.3",
      "@types/node": "^25.6.2",
      "vitest": "^4.1.5",
      "@vitest/ui": "^4.1.5",
      "@vitest/coverage-v8": "^4.1.5",
      "jsdom": "^29.1.1",
      "effect": "^3.12.0",
      "@effect/platform": "^0.69.0",
      "@effect/platform-browser": "^0.69.0",
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version": "changeset version && bun install",
    "release": "bun run build && bun run check-types && bun run test && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@changesets/cli": "^2.31.0",
    "@ikiraro/config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "turbo": "^2.9.12",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "packageManager": "bun@1.3.11"
}
