{
  "name": "@ikiraro/sdk",
  "version": "0.4.1",
  "description": "Ikiraro SDK — sign language translation and rendering",
  "keywords": [
    "accessibility",
    "asl",
    "sdk",
    "sign-language"
  ],
  "homepage": "https://github.com/nkurunziza-saddy/ikiraro#readme",
  "bugs": {
    "url": "https://github.com/nkurunziza-saddy/ikiraro/issues"
  },
  "license": "MIT",
  "author": "Saddy Nkurunziza <nkurunziza-saddy>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkurunziza-saddy/ikiraro.git"
  },
  "files": [
    "dist",
    "skill",
    "bin",
    "README.md"
  ],
  "bin": {
    "ikiraro-sdk": "./bin/add-skill.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./components": {
      "import": "./dist/components.js",
      "types": "./dist/components.d.ts"
    },
    "./engine": {
      "import": "./dist/engine.js",
      "types": "./dist/engine.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@ikiraro/engine": "workspace:*",
    "@ikiraro/renderer": "workspace:*",
    "@ikiraro/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@react-three/drei": ">=10.0.0",
    "@react-three/fiber": ">=9.0.0",
    "effect": ">=3.0.0",
    "react": ">=18",
    "react-dom": ">=18",
    "three": ">=0.170.0"
  },
  "peerDependenciesMeta": {
    "@mediapipe/tasks-vision": {
      "optional": true
    },
    "@react-three/drei": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    }
  }
}
