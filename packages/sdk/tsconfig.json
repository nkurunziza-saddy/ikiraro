{
  "extends": "../config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "..",
    "outDir": "dist",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@ikiraro/runtime": ["../runtime/src/index.ts"],
      "@ikiraro/runtime/*": ["../runtime/src/*"],
      "@ikiraro/renderer": ["../renderer/src/index.ts"],
      "@ikiraro/renderer/*": ["../renderer/src/*"],
      "@ikiraro/engine": ["../engine/src/types.ts"],
      "@ikiraro/engine/*": ["../engine/src/*"]
    }
  },
  "include": ["src"]
}
